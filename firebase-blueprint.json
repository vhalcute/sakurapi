{
  "entities": {
    "User": {
      "title": "User",
      "description": "Informasi profil pengguna aplikasi catatan keuangan",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User ID identik dengan UID otentikasi Firebase"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Alamat email pengguna"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama tampilan pengguna"
        },
        "photoURL": {
          "type": "string",
          "description": "URL foto avatar pengguna"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp ISO pembuatan akun"
        }
      },
      "required": ["id", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Catatan transaksi pemasukan atau pengeluaran keuangan",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID unik dokumen transaksi"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID pemilik transaksi"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Keterangan atau judul transaksi"
        },
        "amount": {
          "type": "number",
          "description": "Nominal transaksi dalam Rupiah"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Jenis transaksi (income / expense)"
        },
        "categoryId": {
          "type": "string",
          "maxLength": 64,
          "description": "ID kategori transaksi"
        },
        "categoryName": {
          "type": "string",
          "maxLength": 64,
          "description": "Nama label kategori transaksi"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10,
          "description": "Tanggal transaksi format YYYY-MM-DD"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Catatan opsional untuk transaksi"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp pembuatan transaksi"
        }
      },
      "required": ["id", "userId", "title", "amount", "type", "categoryId", "categoryName", "date"]
    },
    "Category": {
      "title": "Category",
      "description": "Kategori transaksi keuangan kustom pengguna",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID unik kategori"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID pemilik kategori"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Nama kategori"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Tipe transaksi untuk kategori ini"
        },
        "icon": {
          "type": "string",
          "maxLength": 50,
          "description": "Identifier icon Lucide"
        },
        "color": {
          "type": "string",
          "maxLength": 20,
          "description": "Kode warna hex atau nama warna kategori"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp pembuatan kategori"
        }
      },
      "required": ["id", "userId", "name", "type", "icon", "color"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Konfigurasi preferensi aplikasi pengguna",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID pemilik pengaturan"
        },
        "currency": {
          "type": "string",
          "maxLength": 10,
          "description": "Simbol mata uang (contoh: Rp)"
        },
        "pinEnabled": {
          "type": "boolean",
          "description": "Status kunci PIN aktif atau tidak"
        },
        "pinCode": {
          "type": "string",
          "maxLength": 6,
          "description": "Kode PIN angka pengguna"
        },
        "theme": {
          "type": "string",
          "enum": ["slate", "teal", "ocean", "charcoal"],
          "description": "Tema warna terpilih"
        },
        "userName": {
          "type": "string",
          "maxLength": 50,
          "description": "Nama panggilan pengguna"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp pembaruan terakhir"
        }
      },
      "required": ["userId", "currency", "pinEnabled", "theme", "userName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Menyimpan profil pengguna yang masuk"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Koleksi transaksi keuangan milik pengguna"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Koleksi kategori kustom milik pengguna"
    },
    "/users/{userId}/settings/current": {
      "schema": "UserSettings",
      "description": "Preferensi dan setelan aplikasi per pengguna"
    },
    "/test/{docId}": {
      "description": "Dokumen uji konektivitas dan health check publik"
    }
  }
}
