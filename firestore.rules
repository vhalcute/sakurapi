rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public health and connectivity check
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'amount', 'type', 'categoryId', 'categoryName', 'date']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        data.amount is number && data.amount >= 0 &&
        (data.type == 'income' || data.type == 'expense') &&
        data.categoryId is string && data.categoryId.size() <= 64 &&
        data.categoryName is string && data.categoryName.size() <= 64 &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidCategory(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type', 'icon', 'color']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        (data.type == 'income' || data.type == 'expense') &&
        data.icon is string && data.icon.size() <= 50 &&
        data.color is string && data.color.size() <= 20;
    }

    function isValidSettings(data, userId) {
      return data.keys().hasAll(['userId', 'currency', 'pinEnabled', 'theme', 'userName']) &&
        data.userId == userId &&
        data.currency is string && data.currency.size() <= 10 &&
        data.pinEnabled is bool &&
        data.theme in ['slate', 'teal', 'ocean', 'charcoal'] &&
        data.userName is string && data.userName.size() <= 50 &&
        (!('pinCode' in data) || (data.pinCode is string && data.pinCode.size() <= 6));
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'email']) &&
        data.id == userId &&
        data.email is string && data.email.size() <= 120 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket listing forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;

      // Transactions Subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(request.resource.data, userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Categories Subcollection
      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(categoryId) && isValidCategory(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(categoryId) && isValidCategory(request.resource.data, userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(categoryId);
      }

      // Settings Document
      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingId) && isValidSettings(request.resource.data, userId);
        allow delete: if false;
      }
    }
  }
}
